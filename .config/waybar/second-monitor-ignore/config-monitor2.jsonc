{
   "layer": "top",
   "position": "top",
   "output": "DP-3",

   "reload_style_on_change": true,

   "modules-left": [
      
      "hyprland/workspaces",
      "group/system",
      "network",
  "tray"
   ],
   "modules-center": [
      "clock"
     
   ],
   "modules-right": [

   ],
   "clock": {
      "format": "<span color='#75624c' rise='1500'> </span>{:L%A %m/%d <span color='#716366' rise='1200'>  </span>%I:%M %p}",
      "format-alt": "<span color='#847158'>{:%Y-%m-%d}</span>",
      "interval": 1,
      "tooltip-format": "<tt>{calendar}</tt>",
      "smooth-scrolling-threshold": 0.01,
      "calendar": {
         "mode": "year",
         "mode-mon-col": 3,
         "weeks-pos": "right",
         "on-scroll": 1,
         "format": {
            "months": "<span color='#9f8b78'><b>{}</b></span>",
            "days": "<span color='#bdaa98'><b>{}</b></span>",
            "weeks": "<span color='#75624c'><b>W{}</b></span>",
            "weekdays": "<span color='#716366'><b>{}</b></span>",
            "today": "<span color='#847158'><b><u>{}</u></b></span>"
         }
      },
      "actions": {
         "on-click-right": "mode",
         "on-scroll-up": "shift_up",
         "on-scroll-down": "shift_down"
      }
   },

       "custom/wlsunset": {
        "interval": "once",
        "exec": "if pgrep wlsunset >/dev/null 2>&1; then stdbuf -oL printf '{\"alt\": \"on\"}'; else stdbuf -oL printf '{\"alt\": \"off\"}'; fi",
        "on-click": "sh ~/scripts/wlsunset.sh",
        "signal": 1, // SIGRTMIN+1 or 35
        "return-type": "json",
        "format": "{icon}",
        "tooltip-format": "wlsunset: {alt}",
        "format-icons": {
            "off": "☀️",
            "on": "🌙"
        }
    },

   "power-profiles-daemon": {
  "format": "<span color='#9f8b78'>{icon}</span>",
  "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
  "tooltip": true,
  "format-icons": {
    "default": "",
    "performance": "",
    "balanced": "",
    "power-saver": ""
  }
},

"hyprland/workspaces": {
      "all-outputs": false,
     
      "on-click": "activate",
      "persistent-only": "true",
     
   },




   "group/system": {
	"orientation": "inherit",
	"modules": [
	   "custom/cpuhistory",
      "custom/updates",
      "custom/gpu-usage",
		"cpu",
		"memory",
		"temperature"
    
	]
},

"network": {
    
    "format": "<span color='#bdaa98' rise='1100'></span> {bandwidthDownBits}  <span color='#75624c' rise='1100'></span> {bandwidthUpBits} ",
    "max-length": 50
},


"custom/weather": {
    "exec": "${HOME}/scripts/get-weather.sh Portland+Oregon",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 1200
},

"custom/weather2": {
    "exec": "${HOME}/scripts/get-weather.sh Kristiansand+Norway",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 1200
},

"memory": {
    "interval": 30,
    "format": "<span color='#716366' rise='1050'></span> {}% ",
    "max-length": 10
},
"cpu": {
    "interval": 10,
    "format": "<span color='#847158' rise='1100' size='medium'> </span>{usage}%   ",
    "max-length": 10
},

 "temperature": {
    // "thermal-zone": 2,
    "hwmon-path": "/sys/devices/platform/coretemp.0/hwmon/hwmon5/temp1_input",
    // "critical-threshold": 80,
    // "format-critical": "{temperatureC}°C ",
    "format": "  <span color='#9f8b78' rise='1100'></span> {temperatureC}°C"
},

"custom/gpu-usage": {
  "exec": "cat /sys/class/hwmon/hwmon8/device/gpu_busy_percent",
  "format": "<span color='#bdaa98' rise='1000'>󰍹</span> {}%   ",
  "return-type": "",
  "interval": 1
},



"custom/updates": {
    "format": "<span color='#75624c' size='medium' rise='1300'>󰮯</span> {}   ",
    "return-type": "json",
  
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --interval-seconds 5 --no-aur --network-interval-seconds 300"
},

  "tray": {
      "icon-size": 16,
      "spacing": 10
   },
   
   "hyprland/workspaces": {
      "all-outputs": false,
      "format": "{icon}",
      "on-click": "activate",
      "format-icons": {
         "5": "<span font_size='12pt'>󰭹</span>",
         "6": "<span font_size='14pt'></span>",
         "3": "<span font_size='12pt'>󱎓</span>",
         "4": "<span font_size='12pt'></span>"
      }
   },
 
}

